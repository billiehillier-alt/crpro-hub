# Copy this file to .env (never commit .env) or set these in the host's environment settings (Render).
# Every value here is a placeholder. Real keys are typed in by Jess or Billie, never written in code.

# --- Basics ---
# The port the app listens on (Render sets this by itself).
PORT=4310
# Where the database and uploaded share pictures live. Point it at a persistent disk online.
CRPRO_DATA=./data
# The app's public address, used in emails, tracked links, and sign-in redirects. No slash at the end.
APP_URL=http://localhost:4310
# Optional: a code that must be typed on the one-time "create the owner account" page. Recommended once the app is online.
SETUP_CODE=

# --- Email (password resets, webinar reminders, certificate renewals, social reminders) ---
# Leave SMTP_HOST empty and emails are printed in the server log instead of sent.
SMTP_HOST=
# 587 for STARTTLS, 465 for SSL.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "From" address, like "Clinical Research Pro <hello@clinicalresearchpro.com>".
MAIL_FROM=
# Optional reply-to address.
MAIL_REPLY_TO=

# --- Video storage (Cloudflare R2 or any S3-compatible bucket). Empty = videos saved in ./media-local (testing only). ---
MEDIA_S3_ENDPOINT=
MEDIA_S3_KEY_ID=
MEDIA_S3_SECRET=
# Bucket name (default crpro-media).
MEDIA_S3_BUCKET=crpro-media
# Region (R2 uses auto).
MEDIA_S3_REGION=auto
# Optional: where local videos go when no bucket is set.
MEDIA_LOCAL_DIR=

# --- Zoom (optional): makes, updates, and cancels a Zoom meeting for each webinar without a link ---
# From a Server-to-Server OAuth app made in Jess's Zoom account.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- AI (optional): the SEO topic map and social captions ---
ANTHROPIC_API_KEY=
# The Claude model to use.
AI_MODEL=claude-sonnet-5-5

# --- SEO ---
# Optional: import straight from Semrush. CSV uploads work without it.
SEMRUSH_API_KEY=
# Shared secret (24+ characters) the WordPress site uses to sign its requests to the app. Same value in WordPress's settings.
SITE_KEY=

# --- Social posting (optional). Each is Jess's own developer app; without keys, posts come as email reminders. ---
# Facebook Page (Meta app with Facebook Login for Business). META_FB_CONFIG_ID is optional.
META_FB_APP_ID=
META_FB_APP_SECRET=
META_FB_CONFIG_ID=
# Instagram (Meta app with Instagram API with Instagram Login).
META_IG_APP_ID=
META_IG_APP_SECRET=
# Pinterest (developers.pinterest.com).
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# X (console.x.com, OAuth 2.0 Client ID and Secret).
X_CLIENT_ID=
X_CLIENT_SECRET=
